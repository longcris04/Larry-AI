# Địa chỉ backend Express. Khi chạy local thì trỏ về cổng PORT trong backend/.env
REACT_APP_API_URL=http://localhost:5000

# Không sinh source map khi build (tuỳ chọn)
GENERATE_SOURCEMAP=false

# (Tuỳ chọn) Bỏ qua bước nhận diện cảm xúc bằng camera.
# Dùng khi máy không có webcam, khi demo, hoặc khi chạy thử tự động.
# Giá trị: happy | sad | angry | neutral | surprised | fearful | disgusted
# REACT_APP_FAKE_EMOTION=neutral
