# Lấy API key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Model cho từng tác vụ ---------------------------------------------------
# Ba tác vụ dùng ba model độc lập, đổi riêng từng cái được.
# Danh sách model: https://openrouter.ai/models

# Larry trò chuyện với học sinh — chạy nhiều nhất nên ưu tiên nhanh & rẻ
CHAT_MODEL=google/gemini-2.5-flash-lite

# Tóm tắt hội thoại + chấm mức độ nguy cơ cho quản trị viên.
# Nên chọn model khá hơn model chat vì nó quyết định có gắn cờ hay không.
SUMMARY_MODEL=google/gemini-2.5-flash

# Soạn email cảnh báo gửi giáo viên chủ nhiệm.
# Bỏ trống thì tự dùng SUMMARY_MODEL.
ALERT_MODEL=google/gemini-2.5-flash

# (Tuỳ chọn) OPENROUTER_MODEL là tên cũ của CHAT_MODEL, vẫn còn đọc được
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# (Tuỳ chọn) Chỉ đổi khi bạn dùng proxy tương thích OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# (Tuỳ chọn) Hai giá trị này được gửi kèm để OpenRouter thống kê app của bạn
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=Larry AI

# Cổng chạy backend
PORT=5000

# Khoá ký JWT — BẮT BUỘC đổi thành chuỗi ngẫu nhiên khi deploy thật
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-cua-ban

# (Tuỳ chọn) Đường dẫn file lưu tài khoản, mặc định là backend/account.json
# ACCOUNTS_FILE=./account.json

# Không có biến nào để tạo quản trị viên. Tài khoản admin chỉ tạo được bằng lệnh:
#   npm run create-admin

# (Tuỳ chọn) Tóm tắt lại sau mỗi bao nhiêu tin nhắn mới
# SUMMARY_EVERY_N_MESSAGES=4

# (Tuỳ chọn) Đường dẫn file lưu phiên hội thoại
# SESSIONS_FILE=./sessions.json

# --- Email cảnh báo cho giáo viên chủ nhiệm ----------------------------------
# Tài khoản Gmail dùng để GỬI. KHÔNG dùng mật khẩu Gmail thường ở đây, phải là
# App Password 16 ký tự (bật xác minh 2 bước rồi tạo tại
# https://myaccount.google.com/apppasswords). Dán liền hoặc có dấu cách đều được.
EMAIL_USER=larryai.bluemoon@gmail.com
EMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Tên hiện ở ô người gửi trong hộp thư của giáo viên
# EMAIL_FROM_NAME=Larry AI — Tư vấn tâm lý học đường

# Địa chỉ điền sẵn ở ô "Gửi tới" (quản trị viên vẫn sửa được trước khi gửi)
ALERT_EMAIL_TO=26ai.longnh2@vinuni.edu.vn

# (Tuỳ chọn) SMTP khác Gmail — trường có mail server riêng thì đặt 3 biến này
# EMAIL_HOST=smtp.truong.edu.vn
# EMAIL_PORT=587
# EMAIL_SECURE=false

# --- Hệ multi-agent (LangGraph) ----------------------------------------------
# Model riêng cho supervisor và từng agent. Bỏ trống thì dùng CHAT_MODEL.
# Nên nâng SUPERVISOR_MODEL trước tiên: nó quyết định gọi agent nào.
# SUPERVISOR_MODEL=google/gemini-2.5-flash
# AGENT_SELF_HARM_MODEL=
# AGENT_VICTIM_MODEL=
# AGENT_ACTOR_MODEL=
# AGENT_HOMEROOM_MODEL=

# Số lượt supervisor được hỏi khai thác trong một phiên (mặc định 5)
# MAX_PROBE_TURNS=5

# Số agent nói trong MỘT lượt: luôn là 1, không cấu hình được.
# Nhiều nhóm cùng bật thì nhóm ưu tiên cao nhất thắng
# (self_harm > victim > actor > general) — xem pickAgent trong agents/routing.js.

# Số lượt LIÊN TIẾP model không còn thấy dấu hiệu thì nhóm mới bị gỡ (mặc định 2)
# GROUP_DROP_AFTER_TURNS=2

# Timeout mỗi lần gọi model của agent, tính bằng ms (mặc định 30000)
# AGENT_TIMEOUT_MS=30000
